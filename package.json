{
  "name": "chess-trainer",
  "version": "0.21.0",
  "private": true,
  "description": "Learn, practise and solve chess puzzles at any level — a fully static, installable web app built for GitHub Pages.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "node scripts/setup-engine.mjs --lite && node scripts/setup-maia.mjs --optional",
    "dev": "vite",
    "prebuild": "node scripts/setup-engine.mjs && node scripts/setup-maia.mjs && node scripts/build-lesson-index.mjs",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "preview:pages": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:dead": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run lint:dead && npm run format:check && npm run typecheck && npm run test && npm run build && npm run bundle:check",
    "engine:setup": "node scripts/setup-engine.mjs",
    "maia:setup": "node scripts/setup-maia.mjs",
    "puzzles:import": "node scripts/import-lichess-puzzles.mjs",
    "openings:import": "node scripts/import-openings.mjs",
    "puzzles:verify": "node scripts/verify-puzzles.mjs",
    "puzzles:reindex": "node scripts/reindex-puzzles.mjs",
    "lessons:verify": "node scripts/verify-lessons.mjs",
    "lessons:index": "node scripts/build-lesson-index.mjs",
    "drills:verify": "node scripts/verify-drills.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "readme:screenshots": "node scripts/readme-screenshots.mjs",
    "pieces:generate": "node scripts/generate-pieces.mjs",
    "boards:thumbs": "node scripts/generate-board-thumbs.mjs",
    "studies:verify": "node scripts/verify-studies.mjs",
    "repertoires:verify": "node scripts/verify-repertoires.mjs",
    "arcade:positions": "node scripts/build-arcade-positions.mjs",
    "threats:build": "node scripts/build-threats.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "e2e:visual": "node scripts/visual.mjs",
    "relay:dev": "node relay/src/server.mjs --db :memory: --port 8787",
    "relay:deploy": "npx --yes wrangler@4 deploy --config relay/wrangler.jsonc"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.2",
    "chess.js": "^1.4.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  }
}
