{
  "name": "chess-trainer",
  "version": "0.5.0",
  "private": true,
  "description": "Learn, practice and solve chess puzzles at any level \u2014 a fully static, installable web app built for GitHub Pages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "predev": "node scripts/setup-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/setup-engine.mjs && node scripts/build-lesson-index.mjs",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "engine:setup": "node scripts/setup-engine.mjs",
    "puzzles:import": "node scripts/import-lichess-puzzles.mjs",
    "openings:import": "node scripts/import-openings.mjs",
    "puzzles:verify": "node scripts/verify-puzzles.mjs",
    "lessons:verify": "node scripts/verify-lessons.mjs",
    "lessons:index": "node scripts/build-lesson-index.mjs",
    "drills:verify": "node scripts/verify-drills.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "studies:verify": "node scripts/verify-studies.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.0",
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
