// The device-sync relay on Cloudflare Workers, its vaults in D1 (see README.md).
// `npx wrangler deploy` (Wrangler 4.45 or later) creates the D1 database on the
// first deploy and writes its id back into this file.
{
	"name": "chess-trainer-sync",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-09-01",
	// Node's Buffer, for base64 in native code (see src/d1Store.mjs).
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chess-trainer-sync",
			"database_id": "675bcc92-e6df-4306-aa33-c7fab45e8dc9"
		}
	],
	// Once a day, vaults nobody has written or read for a year are deleted, and
	// reminders nothing has been heard of for 60 days. Every 15 minutes, the
	// reminders due are sent. src/worker.mjs tells them apart by the first.
	"triggers": {
		"crons": [
			"17 3 * * *",
			"*/15 * * * *"
		]
	},
	// Live games: the waiting room is one Durable Object, each game another, and
	// each group room (a puzzle race for up to eight) another (see
	// src/live/cloudflare.mjs). They keep their data in SQLite, the kind the free
	// plan has, and hibernate while their sockets are quiet.
	"durable_objects": {
		"bindings": [
			{
				"name": "LIVE_LOBBY",
				"class_name": "LiveLobby"
			},
			{
				"name": "LIVE_ROOMS",
				"class_name": "LiveRoom"
			},
			{
				"name": "LIVE_GROUPS",
				"class_name": "LiveGroup"
			}
		]
	},
	// The first deploy with each migration creates its classes: live-v1 the waiting
	// room's and the games', live-v2 the group rooms'.
	"migrations": [
		{
			"tag": "live-v1",
			"new_sqlite_classes": [
				"LiveLobby",
				"LiveRoom"
			]
		},
		{
			"tag": "live-v2",
			"new_sqlite_classes": [
				"LiveGroup"
			]
		}
	],
	"vars": {
		// The app's origins — the live site, and the offline copy's launcher on this
		// computer (launcher/) — so pages elsewhere cannot read the relay's answers.
		"ALLOWED_ORIGINS": "https://real-fruit-snacks.github.io,http://localhost:8064",
		"MAX_BYTES": "1400000",
	},
	// No request logs are kept.
	"observability": {
		"enabled": false
	},
}